# paper-analyze 环境配置 / Environment configuration for the paper-analyze skill
#
# 用法：复制本文件为同目录下的 paper-analyze.env 并填入实际值
#   cp config/paper-analyze.env.example config/paper-analyze.env
# 或直接运行 install.sh，它会自动复制本模板到 skill 目录下。
#
# 优先级（高 → 低）：真实 shell 环境变量 > 本文件 > 脚本默认值。
# 本文件已被 .gitignore 排除，密钥不会进仓库。

# ─────────────────────────────────────────────────────────────
# Obsidian vault（必填）
# ─────────────────────────────────────────────────────────────
# 你的 Obsidian 仓库根目录绝对路径。笔记写入 <vault>/20_Research/Papers/，
# 知识图谱写入 <vault>/20_Research/PaperGraph/，
# 语言/领域配置读取自 <vault>/99_System/Config/research_interests.yaml
#
# Windows 示例：C:/Users/yourname/Documents/ObsidianVault
# macOS   示例：/Users/yourname/ObsidianVault
OBSIDIAN_VAULT_PATH=""

# ─────────────────────────────────────────────────────────────
# 阿里云 OSS（可选——仅"步骤6 上传图片到 OSS"需要）
阿里云桶的配置:  https://mp.weixin.qq.com/s/N5-jREfuMGH17jj-A3_V6w
# ─────────────────────────────────────────────────────────────
# 若以下留空，upload_images.py 会回退到 PicGo 的 data.json 配置（自动跨平台定位）。
# 若既未设置以下变量、也未配置 PicGo，图片上传步骤会 fail-fast 报错
# （笔记仍会正常生成并保存到 Obsidian，只是图片保持本地路径）。
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET="my-obsidian-***"
OSS_AREA="oss-cn-beijing"
OSS_PATH="obsidian-img/"

# （高级）若你的 PicGo 配置不在默认位置，可显式指定其 data.json 路径：
# PICGO_CONFIG_PATH=""
